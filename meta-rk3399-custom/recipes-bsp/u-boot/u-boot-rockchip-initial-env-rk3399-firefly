# U-Boot initial environment for RK3399 Firefly
# Kernel is loaded from root partition (partition 4) /boot directory

# Boot configuration
kernel_addr_r=0x00280000
fdt_addr_r=0x03000000
ramdisk_addr_r=0x28000000

# Root device - partition 3 (rootfs)
rootdev=/dev/mmcblk0p3
rootpart=3

# Console configuration
verbosity=7
rootfstype=ext4

# Device tree
fdtfile=rk3399-firefly-aio.dtb

# Kernel image name - will be set by boot script or manually
# Use Image-6.1.115 as default, but boot script will handle version detection
kernel_image=Image-6.1.115

# Helper commands for loading kernel and DTB
load_kernel=ext4load mmc 0:3 ${kernel_addr_r} /boot/Image-6.1.115
load_dtb=ext4load mmc 0:3 ${fdt_addr_r} /boot/rk3399-firefly-aio.dtb

# Boot command - use simple command chain without if-then-else
bootcmd=mmc dev 0; mmc rescan; run load_kernel; run load_dtb; booti ${kernel_addr_r} - ${fdt_addr_r}

# Boot arguments for manual boot
bootargs=earlycon=uart8250,mmio32,0xff1a0000,1500000n8 root=/dev/mmcblk0p3 rootwait rootfstype=ext4 console=ttyS2,1500000 consoleblank=0 loglevel=7

# MMC configuration
mmcdev=0
mmcpart=3
