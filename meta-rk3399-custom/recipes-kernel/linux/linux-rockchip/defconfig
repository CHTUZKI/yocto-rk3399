# RK3399 Complete Kernel Configuration
# This replaces the fragment approach for better control

# ARM64 Architecture
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_VOLUNTARY=y

# Disable EFI STUB to generate standard ARM64 Image for U-Boot
# CONFIG_EFI_STUB is not set
# CONFIG_EFI is not set

# CPU frequency scaling
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
# CONFIG_CPUFREQ_DT is not set
# CONFIG_ARM_RK3399_CPUFREQ is not set

# Rockchip specific
CONFIG_ARCH_ROCKCHIP=y
CONFIG_CPU_RK3399=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_CLK_ROCKCHIP=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_PMU=y
CONFIG_MFD_ROCKCHIP_PMU=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_POWER_AVS=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y

# Serial console - CRITICAL for debugging
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_ARM_SEMIHOST=y
CONFIG_EARLY_PRINTK=y
CONFIG_EARLYCON=y

# I2C debugging and stability fixes
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DEBUG_CORE=y
CONFIG_I2C_DEBUG_ALGO=y
CONFIG_I2C_DEBUG_BUS=y
CONFIG_I2C_RK3X=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# 增加I2C稳定性配置
CONFIG_I2C_SLAVE=y
CONFIG_I2C_ALGOBIT=y
CONFIG_I2C_HELPER_AUTO=y
CONFIG_I2C_BOARDINFO=y
CONFIG_I2C_COMPAT=y

# Regulator support - CRITICAL for power management
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_DEBUG=y
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
CONFIG_REGULATOR_ANATOP=y
CONFIG_REGULATOR_VIRTUAL=y
CONFIG_OF_REGULATOR=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
# 增强调节器稳定性
CONFIG_REGULATOR_ACT8865=y
CONFIG_REGULATOR_AD5398=y
CONFIG_REGULATOR_DA9210=y
CONFIG_REGULATOR_DA9211=y

# Storage - MMC/SD/eMMC support - CRITICAL for root filesystem
CONFIG_MMC=y
CONFIG_PWRSEQ_EMMC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
# SDHCI (for eMMC)
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
# DW MMC (for SD card)
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y
# MMC Debug Support
CONFIG_MMC_DEBUG=y
CONFIG_MMC_TRACE=y
CONFIG_MMC_UNSAFE_RESUME=y
CONFIG_MMC_CLKGATE=y
# 增强MMC稳定性
CONFIG_MMC_PARANOID_SD_INIT=y
CONFIG_MMC_BLOCK_BOUNCE=y

# I2C support (required for some drivers)
CONFIG_I2C=y
CONFIG_I2C_BOARDINFO=y
CONFIG_I2C_COMPAT=y
CONFIG_I2C_CHARDEV=y
