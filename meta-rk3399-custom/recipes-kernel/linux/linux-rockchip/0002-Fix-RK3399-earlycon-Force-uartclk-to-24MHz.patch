From e230fd12b93a0396e99d81bb35858acb7b6c57cd Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Mon, 29 Dec 2025 16:20:28 +0800
Subject: [PATCH] Fix RK3399 earlycon: Force uartclk to 24MHz

---
 drivers/tty/serial/8250/8250_early.c | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/drivers/tty/serial/8250/8250_early.c b/drivers/tty/serial/8250/8250_early.c
index ef6b3115f8d2..8fff80aafbfa 100644
--- a/drivers/tty/serial/8250/8250_early.c
+++ b/drivers/tty/serial/8250/8250_early.c
@@ -158,14 +158,12 @@ int __init early_serial8250_setup(struct earlycon_device *device,
 	if (!(device->port.membase || device->port.iobase))
 		return -ENODEV;
 
-	/* Fix for RK3399 UART2: Set uartclk to 24MHz if not already set
-	 * This is needed for proper baud rate calculation when using earlycon
-	 * with RK3399 UART2 (base address 0xff1a0000)
+	/* Fix for RK3399 UART2: Force uartclk to 24MHz for proper baud rate calculation
+	 * earlycon.c sets uartclk = BASE_BAUD * 16 (usually 115200 * 16 = 1843200)
+	 * but RK3399 UART2 needs 24MHz for 1500000 baud rate to work correctly
 	 */
 	if (device->port.mapbase == 0xff1a0000UL) {
-		if (!device->port.uartclk) {
-			device->port.uartclk = 24000000; /* 24MHz for RK3399 */
-		}
+		device->port.uartclk = 24000000; /* 24MHz for RK3399 UART2 */
 	}
 
 	if (!device->baud) {
