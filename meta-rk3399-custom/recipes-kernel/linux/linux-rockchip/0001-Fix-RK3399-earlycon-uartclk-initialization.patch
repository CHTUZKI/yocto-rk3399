From 1e6680f0bcccdd705e3fdf541abb8b325b9d9d6a Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Mon, 29 Dec 2025 15:50:40 +0800
Subject: [PATCH] Fix RK3399 earlycon uartclk initialization

---
 drivers/tty/serial/8250/8250_early.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/tty/serial/8250/8250_early.c b/drivers/tty/serial/8250/8250_early.c
index 02c9b98a6bbf..ef6b3115f8d2 100644
--- a/drivers/tty/serial/8250/8250_early.c
+++ b/drivers/tty/serial/8250/8250_early.c
@@ -158,6 +158,16 @@ int __init early_serial8250_setup(struct earlycon_device *device,
 	if (!(device->port.membase || device->port.iobase))
 		return -ENODEV;
 
+	/* Fix for RK3399 UART2: Set uartclk to 24MHz if not already set
+	 * This is needed for proper baud rate calculation when using earlycon
+	 * with RK3399 UART2 (base address 0xff1a0000)
+	 */
+	if (device->port.mapbase == 0xff1a0000UL) {
+		if (!device->port.uartclk) {
+			device->port.uartclk = 24000000; /* 24MHz for RK3399 */
+		}
+	}
+
 	if (!device->baud) {
 		struct uart_port *port = &device->port;
 		unsigned int ier;
